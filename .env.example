# ==============================================================================
# Filumart RAG Product Assistant - Environment Configuration Reference
# ==============================================================================

# Application Environment & Logging
APP_ENV=dev                                       # dev, prod, test
LOG_LEVEL=INFO                                    # DEBUG, INFO, WARNING, ERROR
HOST=0.0.0.0                                      # Server network binding interface
PORT=8000                                         # Server port

# Vector Database (Qdrant)
QDRANT_MODE=server                                # server, local, memory
QDRANT_URL=http://localhost:6333                  # Host URL for server mode (or http://qdrant:6333 in Docker)
QDRANT_PATH=./qdrant_local                        # Storage path for local embedded mode
COLLECTION_PREFIX=filumart                        # Prefix for collection naming

# Ingestion & Chunking
CHUNKER=structured                                # structured, fixed
CHUNK_TARGET_TOKENS=250                           # Target token size for recursive chunking
DATA_DIR=data/raw                                 # Directory containing raw catalog and documents

# Embeddings & Reranking (Local ONNX models via FastEmbed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5            # FastEmbed dense embedding model
FASTEMBED_CACHE_PATH=./.fastembed_cache           # Filesystem cache for models (/opt/models in Docker)
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2     # Cross-encoder model (empty string disables)

# Retrieval & Fusion Parameters
RETRIEVAL_MODE=hybrid                             # hybrid, dense, sparse
TOP_K=5                                           # Final candidate chunks delivered to generator
CANDIDATES=20                                     # Candidates retrieved before reranking
RRF_K=60                                          # Smoothing constant for Reciprocal Rank Fusion
ENTITY_BOOST=1.25                                 # Score multiplier for chunks matching extracted entities
PER_PRODUCT_CAP=3                                 # Maximum chunks per product for non-comparison queries
GATE_ENABLED=true                                 # Relevance threshold gate enabled
SCORE_THRESHOLD=0.45                              # Minimum cosine similarity to proceed to generation

# Generation & Provider Router
LLM_PROVIDERS=gemini,groq,openrouter,ollama       # Comma-separated provider priority order
LLM_MODE=live                                     # live, retrieval_only, replay
LLM_TEMPERATURE=0.1                               # Low temperature for factual generation
LLM_MAX_TOKENS=700                                # Maximum tokens in answer
LLM_CACHE_WRITE=false                             # Cache live responses to disk
LLM_CACHE_PATH=data/cache/llm_answers.jsonl       # Cache file path

# Primary Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-flash-lite

# Secondary Provider: Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
JUDGE_MODEL=llama-3.3-70b-versatile

# Optional Failover Provider: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Local LLM Fallback: Ollama
OLLAMA_BASE_URL=                                  # e.g. http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Timeouts & SSE Keep-Alive (in seconds)
EMBED_TIMEOUT_S=10.0
RETRIEVAL_TIMEOUT_S=10.0
LLM_FIRST_TOKEN_TIMEOUT_S=20.0
LLM_IDLE_TIMEOUT_S=20.0
REQUEST_TIMEOUT_S=90.0
HEARTBEAT_S=15.0

# OCR & Vision Fallback
TESSERACT_CMD=                                    # Optional path, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
OCR_DPI=300
OCR_MIN_TEXT_CHARS=50
OCR_CONF_THRESHOLD=0.60
VISION_FALLBACK=true
VISION_CACHE_PATH=data/cache/vision_ocr.jsonl